<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Tokenomics</string>
    <key>CFBundleDisplayName</key>
    <string>Tokenomics</string>
    <key>CFBundleIdentifier</key>
    <string>dev.local.tokenomics</string>
    <!-- Build identifier — overwritten with the short git commit hash by Scripts/build_app.sh so every
         built .app is traceable to the exact source it came from. This checked-in value is only what
         `swift run` (no bundling step) sees. -->
    <key>CFBundleVersion</key>
    <string>dev</string>
    <!-- Marketing version — bump this alongside the release tag; see CONTRIBUTING.md#versioning. -->
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>Tokenomics</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Personal tool — no distribution.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Tokenomics uses Automation to ask your terminal (Ghostty or iTerm2) which tab is open in a given project directory, so it can bring that tab to the front when you click a session.</string>
</dict>
</plist>
